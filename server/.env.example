SERVER_ADDR=:1011
DATABASE_DSN=root:password@tcp(127.0.0.1:3306)/infinite_canvas?charset=utf8mb4&parseTime=True&loc=UTC
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

SESSION_COOKIE=ic_session
SESSION_TTL=168h
SESSION_MAX_TTL=720h
EMAIL_VERIFICATION_TTL=30m
PASSWORD_RESET_TTL=30m
PAYMENT_ORDER_TTL=30m
QUOTE_TTL=5m
RELAY_TIMEOUT=5m
COOKIE_SECURE=false
DEV_EXPOSE_TOKENS=false

PUBLIC_WEB_URL=http://localhost:1010

# 反向代理信任列表（逗号分隔的 IP 或 CIDR）。留空表示不信任任何代理，
# 此时客户端 IP 取真实连接来源，伪造 X-Forwarded-For 无法绕过登录/注册/找回密码的频率限制。
# 若账户服务部署在 nginx / 负载均衡 / CDN 之后，必须填入代理地址，例如：
# TRUSTED_PROXIES=172.18.0.2,10.0.0.0/8
TRUSTED_PROXIES=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

EMAIL_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=true
REGISTRATION_ENABLED=true
EMAIL_DOMAIN_RESTRICTION_ENABLED=false
EMAIL_ALIAS_RESTRICTION_ENABLED=false
EMAIL_ALLOWED_DOMAINS=
EMAIL_BLOCKED_DOMAINS=
SMTP_SSL_ENABLED=false
SMTP_FORCE_AUTH_LOGIN=false

ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
INVITATION_REWARD_OPEN=false
INVITATION_INVITER_QUOTA=0
INVITATION_INVITEE_QUOTA=0

EPAY_ENABLED=false
EPAY_GATEWAY_URL=
EPAY_PARTNER_ID=
EPAY_KEY=
EPAY_PAY_METHODS=alipay,wxpay
EPAY_CALLBACK_URL=http://localhost:1011

# 文件存储：local 写本机磁盘（默认，开发用），s3 走任意 S3 兼容对象存储。
# 代码只认 S3 协议，切换供应商只改下面几个变量，不改代码。
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/uploads
STORAGE_PUBLIC_BASE=/api/v1/files

# ---- S3 兼容对象存储（STORAGE_DRIVER=s3 时生效，当前版本尚未接入驱动）----
# MinIO（自建 / 私有化）
# S3_ENDPOINT=http://127.0.0.1:9000
# Cloudflare R2
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# 阿里云 OSS
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# 腾讯云 COS
# S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# Backblaze B2
# S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# AWS S3
# S3_ENDPOINT=https://s3.ap-northeast-1.amazonaws.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 自建 MinIO / R2 / OSS / COS 需要 path-style；AWS S3 可设为 false。
S3_USE_PATH_STYLE=true
